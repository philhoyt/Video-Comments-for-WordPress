{
	"extends": [ "@wordpress/stylelint-config" ],
	"ignoreFiles": [ "build/**", "lib/**", "plans/**", "vendor/**", "node_modules/**" ],
	"rules": {
		"no-descending-specificity": null,
		"selector-class-pattern": [
			"^[a-z][a-z0-9-]*(__[a-z][a-z0-9-]*)?(--[a-z0-9][a-z0-9-]*)?$",
			{
				"message": "Selector should use BEM-style lowercase with hyphens (block__element--modifier)."
			}
		]
	}
}
