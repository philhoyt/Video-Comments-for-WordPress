{
    "name": "video-comments/video-comments",
    "description": "WordPress plugin for video comments via Mux",
    "type": "wordpress-plugin",
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcsstandards/phpcsutils": "^1.0",
        "phpcsstandards/phpcsextra": "^1.2"
    },
    "license": "GPL-2.0-or-later",
    "require": {
        "yahnis-elsts/plugin-update-checker": "^5.3"
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "copy-puc": "rsync -a --delete vendor/yahnis-elsts/plugin-update-checker/ lib/plugin-update-checker/",
        "post-install-cmd": "@copy-puc",
        "post-update-cmd": "@copy-puc"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
