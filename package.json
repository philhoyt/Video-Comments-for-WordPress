{
  "name": "video-comments",
  "version": "1.2.0",
  "description": "Let commenters attach a short video to their comment. Videos upload directly to [Mux](https://www.mux.com/) — WordPress never touches the file, just stores an ID and renders a player.",
  "files": [
    "assets",
    "includes",
    "languages",
    "lib",
    "README.md",
    "readme.txt",
    "uninstall.php",
    "video-comments.php"
  ],
  "scripts": {
    "lint:js": "eslint assets/",
    "lint:css": "stylelint \"assets/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "plugin-zip": "wp-scripts plugin-zip",
    "make-pot": "wp i18n make-pot . languages/video-comments.pot --slug=video-comments --domain=video-comments --exclude=vendor,node_modules,lib",
    "test:unit": "wp-scripts test-unit-js",
    "test:e2e": "wp-scripts test-playwright",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:reset": "wp-env reset",
    "test:php": "wp-env run tests-cli --env-cwd wp-content/plugins/video-comments -- vendor/bin/phpunit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philhoyt/Video-Comments-for-WordPress.git"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-2.0-or-later",
  "bugs": {
    "url": "https://github.com/philhoyt/Video-Comments-for-WordPress/issues"
  },
  "homepage": "https://github.com/philhoyt/Video-Comments-for-WordPress#readme",
  "devDependencies": {
    "@wordpress/env": "^12.0.0",
    "@wordpress/eslint-plugin": "^28.0.0",
    "@wordpress/scripts": "^37.0.0",
    "@wordpress/stylelint-config": "^27.0.0",
    "eslint": "^10.13.0",
    "stylelint": "^17.16.0"
  }
}
