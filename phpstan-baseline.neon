parameters:
	ignoreErrors:
		-
			message: '#^Callback expects 1 parameter, \$accepted_args is set to 2\.$#'
			identifier: arguments.count
			count: 1
			path: includes/class-comment-meta.php

		-
			message: '#^Constant VIDEO_COMMENTS_PLUGIN_URL not found\.$#'
			identifier: constant.notFound
			count: 2
			path: includes/class-render.php

		-
			message: '#^Strict comparison using \=\=\= between false and string will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: includes/class-render.php

		-
			message: '#^Constant VIDEO_COMMENTS_PLUGIN_DIR not found\.$#'
			identifier: constant.notFound
			count: 1
			path: includes/class-video-comments.php
