includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    paths:
        - video-comments.php
        - includes
    excludePaths:
        - vendor
        - node_modules (?)
        - tests (?)
        - lib
    bootstrapFiles:
        - tests/phpstan/constants.php
        - lib/plugin-update-checker/plugin-update-checker.php
